# GEMINI_API_KEY: Required for Gemini AI coaching feedback.
# Obtain an API key from https://aistudio.google.com/ or Google Cloud Console.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Base URL for web requests and callbacks.
APP_URL="http://localhost:3000"

# PORT: Server listening port (default: 3000)
PORT=3000
